<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" spacing="8" padding="10" fx:controller="clases.proyectopruebas.controllers.LibrosViewController">
    <HBox spacing="6">
        <TextField fx:id="txtBuscar" promptText="Buscar por título, autor o categoría" HBox.hgrow="ALWAYS"/>
        <Button text="Buscar" onAction="#onBuscar"/>
        <Button text="Nuevo" onAction="#onNuevo"/>
        <Button text="Editar" onAction="#onEditar"/>
        <Button text="Eliminar" onAction="#onEliminar"/>
    </HBox>
    <TableView fx:id="tablaLibros" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="ID" fx:id="colId" prefWidth="60"/>
            <TableColumn text="Título" fx:id="colTitulo" prefWidth="220"/>
            <TableColumn text="Autor" fx:id="colAutor" prefWidth="160"/>
            <TableColumn text="Categoría" fx:id="colCategoria" prefWidth="140"/>
            <TableColumn text="Disponibles" fx:id="colCantidad" prefWidth="100"/>
        </columns>
    </TableView>
</VBox>
